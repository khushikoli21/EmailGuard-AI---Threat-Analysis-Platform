# ==============================================================================
# ENVIRONMENT CONFIGURATION - EMAILGUARD AI BACKEND
# ==============================================================================

# Application Environment: 'development', 'testing', or 'production'
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS Origins (comma-separated list for frontend dev and staging)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database URL
# For local SQLite development fallback:
DATABASE_URL=sqlite:///./emailguard.db
# For PostgreSQL production / staging:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emailguard_db

# Security & Encryption Key for storing OAuth tokens (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRET_KEY=change_this_to_a_secure_random_key_in_production_32bytes_min

# LLM Provider Configuration ('gemini', 'openai', 'groq', or 'mock')
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Threat Intelligence APIs (Optional - leave blank if not configured)
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=

# Vector Database (ChromaDB) Path
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Google Cloud OAuth 2.0 Credentials (for Gmail API Integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback
